{
  "name": "back-to-arxiv",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "A small Chrome extension that opens alphaXiv papers on arXiv.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:store": "npm run package && node scripts/store-kit.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:memory": "npm run build && node tests/memory.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
